# LemAstra API environment template — NON-SECRET VALUES ONLY.
#
# Copy to api/.env (gitignored). Secrets (API keys, service keys, tokens)
# must NEVER be placed in any .env file committed to this repository —
# server-side credentials live only in local/deployment configuration that
# is never tracked. GOOGLE_API_KEY is a SERVER-ONLY secret: it must never
# appear in the client, in EXPO_PUBLIC_*, or in any log line.
#
# Non-secret service configuration (safe to commit values for in this
# template) lives below.

# Server-only Google Geocoding + Time Zone key (D-05/D-07). Leave empty for
# local development without live place search — the manual fallback path
# and all tests work without it.
GOOGLE_API_KEY=

# Calculator subprocess timeout in seconds (~40 ms verified runtime;
# 10 s gives ~250x headroom).
LEMASTRA_CALC_TIMEOUT_S=10

# CORS allowlist (comma-separated origins) for the Expo dev servers.
LEMASTRA_ALLOW_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
